{
  "manifest_version": 3,
  "name": "StarPanel: sesión de Starlink",
  "version": "1.1.2",
  "description": "Toma las cookies de starlink.com del navegador y las manda al panel.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://starlink.com/*",
    "https://*.starlink.com/*",
    "http://localhost:8000/*",
    "https://panel.ejemplo.org/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Enviar sesión de Starlink a StarPanel" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "https://panel.ejemplo.org/*"
      ],
      "js": ["panel.js"]
    }
  ]
}

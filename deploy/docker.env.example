# StarPanel — variables para Docker Compose
# Copia este fichero a `.env` en el directorio raíz (junto a docker-compose.yml)
# y rellénalo. Los secretos se generan así:
#   docker compose run --rm backend python make_secrets.py 'TU_CONTRASEÑA_AQUÍ'

# Dominio público al que apunta este panel (ej. panel.ejemplo.org).
# Necesario para el certificado automático de Let's Encrypt.
DOMAIN=

# Correo para avisos de Let's Encrypt (caducidad de certificado).
ACME_EMAIL=

# Generados con: docker compose run --rm backend python make_secrets.py 'tu-contraseña'
# HASH de la contraseña de acceso al panel (scrypt). NUNCA la contraseña plana.
PANEL_PASSWORD_HASH=

# Secreto para firmar los tokens de sesión del panel (aleatorio, largo).
PANEL_SESSION_SECRET=

# Token para que la extensión inyecte la cookie de Starlink (aleatorio).
INGEST_TOKEN=

# Zona horaria del servidor
TZ=Europe/Madrid
